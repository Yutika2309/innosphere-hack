# Repair -> one retry -> final insert helpers
# -----------------------------------------------------------------------------
def _rr_json_dumps(value):
    import json
    try:
        return json.dumps(value, ensure_ascii=False, sort_keys=True)
    except Exception:
        return str(value)

def _rr_is_blank(value):
    return value is None or value == "" or value == [] or value == {}

def _rr_join_if_list(value):
    if isinstance(value, list):
        return ",".join(str(x) for x in value)
    if isinstance(value, dict):
        return _rr_json_dumps(value)
    return value

def _rr_meta(row, status="valid", errors=None, notes=None, raw=None, retry_attempted=False, retry_success=False, retry_attempt=0):
    row.setdefault("validation_status", status)
    row.setdefault("validation_errors", "; ".join(errors or []))
    row.setdefault("repair_notes", "; ".join(notes or []))
    row.setdefault("retry_attempted", bool(retry_attempted))
    row.setdefault("retry_success", bool(retry_success))
    row.setdefault("retry_attempt", int(retry_attempt or 0))
    row.setdefault("raw_row_json", _rr_json_dumps(raw if raw is not None else row))
    return row

def repair_retry_insert_row(table_name, row, timestep, context=None):
    context = context or {}
    raw = dict(row or {})
    row = dict(row or {})
    errors, notes = [], []
    if "action_details" in row and _rr_is_blank(row.get("action_detail")):
        row["action_detail"] = _rr_json_dumps(row.get("action_details")); notes.append("action_details -> action_detail")
    if isinstance(row.get("action_detail"), (dict, list)):
        row["action_detail"] = _rr_json_dumps(row.get("action_detail")); notes.append("action_detail serialised")
    if "type" in row and _rr_is_blank(row.get("action_type")):
        row["action_type"] = row.get("type"); notes.append("type -> action_type")
    if "action_name" in row and _rr_is_blank(row.get("action_type")):
        row["action_type"] = row.get("action_name"); notes.append("action_name -> action_type")
    if not _rr_is_blank(row.get("action_id")):
        row["action_id"] = str(row.get("action_id"))
    if table_name == "marketing_actions":
        if "target_audience" in row and _rr_is_blank(row.get("target_segment")):
            row["target_segment"] = _rr_join_if_list(row.get("target_audience")); notes.append("target_audience -> target_segment")
        if isinstance(row.get("target_segment"), (list, dict)):
            row["target_segment"] = _rr_join_if_list(row.get("target_segment")); notes.append("target_segment serialised")
        if "channels" in row and _rr_is_blank(row.get("marketing_channel")):
            row["marketing_channel"] = _rr_join_if_list(row.get("channels")); notes.append("channels -> marketing_channel")
        if "budget_eur" in row and _rr_is_blank(row.get("marketing_spend_eur")):
            row["marketing_spend_eur"] = row.get("budget_eur"); notes.append("budget_eur -> marketing_spend_eur")
    if table_name == "customer_feedback" and _rr_is_blank(row.get("message")):
        parts = []
        for k in ["feedback_type", "selected_offer_id", "offer_id", "selected_bank_id", "bank_id", "product_id"]:
            if not _rr_is_blank(row.get(k)): parts.append(f"{k}={row.get(k)}")
        row["message"] = "Customer movement/feedback recorded: " + ", ".join(parts) if parts else "Customer movement/feedback recorded."
        notes.append("message generated")
    if table_name in {"marketplace_rankings", "marketplace_recommendations"}:
        if _rr_is_blank(row.get("product_id")) and not _rr_is_blank(row.get("product_name")):
            row["product_id"] = str(row.get("product_name")).lower().replace(" ", "_"); notes.append("product_id from product_name")
        if _rr_is_blank(row.get("product_id")) and not _rr_is_blank(row.get("offer_id")):
            row["product_id"] = str(row.get("offer_id")); notes.append("product_id from offer_id")
        if table_name == "marketplace_recommendations" and _rr_is_blank(row.get("recommendation_reason")):
            row["recommendation_reason"] = row.get("recommendation_text") or row.get("recommendation_details") or row.get("recommendation_narrative") or "Marketplace recommendation generated."
            notes.append("recommendation_reason generated")
    if table_name == "bank_offers":
        if _rr_is_blank(row.get("valid_from_timestep")):
            row["valid_from_timestep"] = timestep; notes.append("valid_from_timestep defaulted")
        if _rr_is_blank(row.get("valid_to_timestep")):
            validity = int(context.get("default_offer_validity_timesteps", 3) or 3)
            row["valid_to_timestep"] = int(timestep) + max(1, validity) - 1; notes.append("valid_to_timestep defaulted")
    row.setdefault("timestep", timestep)
    if _rr_is_blank(row.get("actor_id")):
        row["actor_id"] = context.get("actor_id") or context.get("bank_id") or context.get("consumer_id") or "unknown"; notes.append("actor_id defaulted")
    if _rr_is_blank(row.get("action_id")):
        row["action_id"] = f"{table_name}-{timestep}-{row.get('actor_id')}-{abs(hash(_rr_json_dumps(raw))) % 100000}"; notes.append("action_id generated")
    required = {"bank_actions": ["action_type"], "bank_offers": ["offer_id", "bank_id", "product_id"], "customer_feedback": ["consumer_id", "message"], "marketplace_rankings": ["offer_id", "bank_id", "product_id", "rank"], "marketplace_recommendations": ["offer_id", "bank_id", "product_id"]}
    for field in required.get(table_name, []):
        if _rr_is_blank(row.get(field)): errors.append(f"missing required field after repair: {field}")
    status = "unrepaired" if errors else "repaired" if notes else "valid"
    return _rr_meta(row, status=status, errors=errors, notes=notes, raw=raw)

def expand_nested_rows_for_retry_insert(table_name, rows):
    expanded = []
    for row in rows or []:
        row = dict(row or {})
        if table_name == "marketplace_rankings" and isinstance(row.get("ranks"), list):
            for item in row.get("ranks") or []:
                if isinstance(item, dict):
                    child = dict(row); child.pop("ranks", None); child.update(item); child.setdefault("ranking_id", row.get("ranking_id") or row.get("ranking_category")); expanded.append(child)
            continue
        if table_name == "marketplace_recommendations" and isinstance(row.get("recommended_offers"), list):
            for item in row.get("recommended_offers") or []:
                if isinstance(item, dict):
                    child = dict(row); child.pop("recommended_offers", None); child.update(item); child.setdefault("recommendation_reason", row.get("recommendation_narrative") or row.get("recommendation_text") or row.get("recommendation_details")); expanded.append(child)
            continue
        if table_name == "marketplace_recommendations" and isinstance(row.get("recommended_offer_ids"), list):
            for offer_id in row.get("recommended_offer_ids") or []:
                child = dict(row); child.pop("recommended_offer_ids", None); child["offer_id"] = offer_id; expanded.append(child)
            continue
        expanded.append(row)
    return expanded
