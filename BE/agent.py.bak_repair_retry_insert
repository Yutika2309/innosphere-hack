async def _invoke_agent_once(agent: Agent, app_name: str, prompt_payload: Dict[str, Any]) -> Dict[str, Any]:
    jitter_seconds = _parallel_agent_start_jitter_seconds()
    if jitter_seconds > 0:
        await asyncio.sleep(random.uniform(0, jitter_seconds))
    semaphore = _get_parallel_agent_semaphore()
    async with semaphore:
        return await _invoke_agent_once_unlimited(agent, app_name, prompt_payload)


async def _invoke_agent_once_unlimited(agent: Agent, app_name: str, prompt_payload: Dict[str, Any]) -> Dict[str, Any]:
    session_service = InMemorySessionService()
    runner = Runner(agent=agent, app_name=app_name, session_service=session_service)
    user_id = f"{app_name}_user"
    session_id = f"{app_name}_{_SESSION.get('run_id') or 'run'}_{uuid.uuid4().hex[:8]}"
    summary = _context_summary(prompt_payload)
    agent_logger.info(
        "AGENT_CALL_START run_id=%s agent=%s app=%s session_id=%s timestep=%s actor_type=%s actor_id=%s public_rows=%s has_public_summary=%s public_summary_chars=%s has_marketplace_dashboard=%s candidate_offer_count=%s customer_count=%s has_private_summary=%s",
        _SESSION.get("run_id"), getattr(agent, "name", str(agent)), app_name, session_id,
        summary.get("timestep"), summary.get("actor_type"), summary.get("actor_id"), summary.get("public_rows"),
        summary.get("has_public_summary"), summary.get("public_summary_chars"), summary.get("has_marketplace_dashboard"),
        summary.get("candidate_offer_count"), summary.get("customer_count"), summary.get("has_private_summary"),
    )
    started = time.time()
    await session_service.create_session(app_name=app_name, user_id=user_id, session_id=session_id)
    payload_text = json.dumps(json_safe(prompt_payload), ensure_ascii=False, separators=(",", ":"), allow_nan=False)
    events_stream = runner.run_async(user_id=user_id, session_id=session_id, new_message=Content(role="user", parts=[Part(text=payload_text)]))
    final_text = ""
    event_count = 0
    async for event in events_stream:
        event_count += 1
        if event.is_final_response():
            if event.content and event.content.parts:
                final_text = event.content.parts[0].text or ""
            break
    elapsed = round(time.time() - started, 3)
    agent_logger.info("AGENT_CALL_DONE run_id=%s agent=%s app=%s session_id=%s timestep=%s actor_type=%s actor_id=%s elapsed_sec=%s events=%s final_text_chars=%s", _SESSION.get("run_id"), getattr(agent, "name", str(agent)), app_name, session_id, summary.get("timestep"), summary.get("actor_type"), summary.get("actor_id"), elapsed, event_count, len(final_text or ""))
    return {"session_id": session_id, "final_text": final_text, "elapsed_sec": elapsed, "event_count": event_count}


async def _run_agentic_single_iteration() -> Dict[str, Any]:
    sim = _require_sim()
    if sim is None:
        return {"status": "error", "message": "Initialize simulation first."}
    if sim.completed:
        return {"status": "done", "message": "Simulation already complete.", "final_status": get_status()}

    run_id = _SESSION["run_id"] or "unknown"
    _SESSION["llm_step_invocations"] += 1
    llm_step_no = _SESSION["llm_step_invocations"]
    started = time.time()
    timestep = sim.current_timestep + 1
    _reset_pending_outputs()

    parallel_tasks: List[Any] = []
    task_metadata: List[Dict[str, Any]] = []
    _log_stage("PARALLEL_AGENTS_PREPARE", timestep, run_id=run_id, llm_step=llm_step_no, semaphore_limit=_parallel_agent_semaphore_limit())

    if sim.cfg.enable_world_news_agent:
        ctx = sim.build_world_news_agent_context()
        ctx.pop("public_information", None)
        ctx.pop("public_information_summary", None)
        ctx.pop("marketplace_dashboard", None)
        ctx["exogenous"] = True
        ctx["instruction"] = "Generate external market/world news independent of simulation outputs."
        parallel_tasks.append(_invoke_agent_once(world_news_agent, "world_news_agent_app", ctx))
        task_metadata.append({"agent": "world_news_agent", "actor_id": ctx.get("actor_id", "world_news")})

    if sim.cfg.enable_bank_agent:
        for ctx in sim.build_bank_agent_contexts():
            bank_ctx = _replace_public_rows_with_summary(ctx)
            bank_ctx["bank_id"] = ctx.get("bank_id") or ctx.get("actor_id")
            bank_ctx.pop("current_pending_marketplace_outputs", None)
            parallel_tasks.append(_invoke_agent_once(bank_agent, "bank_agent_app", bank_ctx))
            task_metadata.append({"agent": "bank_agent", "actor_id": bank_ctx.get("bank_id")})

    if getattr(sim.cfg, "enable_marketplace_agent", True):
        marketplace_ctx = _replace_public_rows_with_summary(sim.build_marketplace_agent_context())
        marketplace_ctx.pop("current_pending_bank_public_outputs", None)
        marketplace_ctx["reads_committed_state_only"] = True
        marketplace_ctx["source_snapshot_timestep"] = sim.current_timestep
        parallel_tasks.append(_invoke_agent_once(marketplace_agent, "marketplace_agent_app", marketplace_ctx))
        task_metadata.append({"agent": "marketplace_agent", "actor_id": "loan_marketplace"})

    if sim.cfg.enable_customer_agent:
        contexts = sim.build_customer_agent_contexts()
        for batch_index, batch_contexts in enumerate(_chunks(contexts, _customer_agent_batch_size()), start=1):
            batch_payload = _build_customer_batch_payload(batch_contexts, timestep, batch_index)
            parallel_tasks.append(_invoke_agent_once(customer_agent, "customer_agent_app", batch_payload))
            task_metadata.append({"agent": "customer_agent", "actor_id": batch_payload.get("actor_id"), "batch_index": batch_index, "batch_size": len(batch_contexts)})

    _log_stage("PARALLEL_AGENTS_START", timestep, total=len(parallel_tasks), world=sum(1 for m in task_metadata if m.get("agent") == "world_news_agent"), banks=sum(1 for m in task_metadata if m.get("agent") == "bank_agent"), marketplace=sum(1 for m in task_metadata if m.get("agent") == "marketplace_agent"), customer_batches=sum(1 for m in task_metadata if m.get("agent") == "customer_agent"))

    results = await asyncio.gather(*parallel_tasks, return_exceptions=True)
    agent_invocations: List[Dict[str, Any]] = []
    failed: List[Dict[str, Any]] = []
    for meta, result_item in zip(task_metadata, results):
        if isinstance(result_item, Exception):
            agent_logger.error("PARALLEL_AGENT_FAILED run_id=%s timestep=%s agent=%s actor_id=%s error_type=%s error=%s", run_id, timestep, meta.get("agent"), meta.get("actor_id"), type(result_item).__name__, result_item)
            failure = {**meta, "status": "error", "error_type": type(result_item).__name__, "error": str(result_item)}
            failed.append(failure)
            agent_invocations.append(failure)
        else:
            agent_invocations.append({**meta, **result_item})

    _log_stage("PARALLEL_AGENTS_DONE", timestep, total=len(results), failed=len(failed))
    if failed:
        return {"status": "error", "message": "One or more parallel agents failed.", "failed_agent_invocations": failed, "agent_invocations": agent_invocations}

    pending_outputs = dict(_SESSION.get("pending_agent_outputs") or {})
    pending_counts = {k: len(v or []) for k, v in pending_outputs.items()}
    _log_stage("COMMIT_START", timestep, pending_counts=pending_counts)
    result = sim.run_timestep(agent_outputs=pending_outputs)
    _log_stage("COMMIT_DONE", result.get("timestep", timestep), completed=result.get("completed"), rows_written=result.get("rows_written"))

    if sim.cfg.enable_post_processing_agent:
        post_ctx = sim.build_post_processing_agent_context()
        post_ctx["engine_post_processing_result"] = result.get("post_processing")
        post_ctx["post_processing_role"] = "Create public_information_summary and marketplace_dashboard inputs for future timesteps only."
        _log_stage("POST_PROCESSING_START", result.get("timestep", timestep), tasks=1)
        post_result = await _invoke_agent_once(post_processing_agent, "post_processing_agent_app", post_ctx)
        agent_invocations.append({"agent": "post_processing_agent", "actor_id": "post_processing", **post_result})
        _log_stage("POST_PROCESSING_DONE", result.get("timestep", timestep), status=post_result.get("status"))

    elapsed = round(time.time() - started, 3)
    _log_stage("DONE", timestep, elapsed_sec=elapsed, completed=result.get("completed"), agent_invocations=len(agent_invocations))
    return {"run_id": run_id, "llm_step_invocation": llm_step_no, "elapsed_sec": elapsed, "parallel_agent_invocations": len([x for x in agent_invocations if x.get("agent") != "post_processing_agent"]), "agent_invocation_summary": {"total": len(agent_invocations), "failed": len([x for x in agent_invocations if x.get("status") == "error"])}, **result}


async def run_single_iteration() -> Dict[str, Any]:
    sim = _require_sim()
    if sim is None:
        return {"status": "error", "message": "Initialize simulation first."}
    if getattr(sim.cfg, "agentic_mode", False):
        return await _run_agentic_single_iteration()
    _SESSION["llm_step_invocations"] += 1
    started = time.time()
    result = sim.run_timestep()
    return {"run_id": _SESSION.get("run_id"), "llm_step_invocation": _SESSION["llm_step_invocations"], "elapsed_sec": round(time.time() - started, 3), **result}


