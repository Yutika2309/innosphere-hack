def _append_pending(logical_name: str, rows: List[Dict[str, Any]]) -> Dict[str, Any]:
    if "pending_agent_outputs" not in _SESSION or not _SESSION["pending_agent_outputs"]:
        _reset_pending_outputs()
    clean_rows = [dict(row) for row in rows or []]
    if not clean_rows:
        agent_logger.debug("ROWS_SKIP_EMPTY run_id=%s table=%s", _SESSION.get("run_id"), logical_name)
        return {"status": "ok", "logical_name": logical_name, "rows_recorded": 0, "skipped_empty": True}
    _SESSION["pending_agent_outputs"].setdefault(logical_name, []).extend(clean_rows)
    agent_logger.info(
        "ROWS_ADDED run_id=%s table=%s +%s pending=%s",
        _SESSION.get("run_id"), logical_name, len(clean_rows), len(_SESSION["pending_agent_outputs"].get(logical_name, [])),
    )
    return {"status": "ok", "logical_name": logical_name, "rows_recorded": len(clean_rows)}


def _rows_from_payload(payload: Dict[str, Any], key: str = "rows") -> List[Dict[str, Any]]:
    payload = dict(payload or {})
    rows = payload.get(key, [])
    if isinstance(rows, dict):
        return [dict(rows)]
    if isinstance(rows, list):
        return [dict(row) for row in rows if isinstance(row, dict)]
    return []


def _record_invalid_rows(table_name: str, invalid_rows: List[Dict[str, Any]]) -> None:
    if not invalid_rows:
        return
    max_rows = int(_cfg_value("max_invalid_rows_logged_per_timestep", 100) or 100)
    limited = invalid_rows[:max_rows]
    _append_pending("invalid_rows", limited)
    agent_logger.warning(
        "INVALID_ROWS_QUARANTINED run_id=%s table=%s invalid=%s logged=%s",
        _SESSION.get("run_id"), table_name, len(invalid_rows), len(limited),
    )


def _validate_rows_for_table(table_name: str, rows: List[Dict[str, Any]], *, context: Optional[Dict[str, Any]] = None) -> List[Dict[str, Any]]:
    result = validate_and_normalise_rows(
        table_name,
        rows or [],
        _pending_timestep(),
        context=context or {},
        strict=bool(_cfg_value("strict_schema_validation_enabled", True)),
    )
    invalid_dicts: List[Dict[str, Any]] = []
    for invalid in result.invalid_rows:
        invalid_dicts.append(invalid.model_dump() if hasattr(invalid, "model_dump") else invalid.dict())
    _record_invalid_rows(table_name, invalid_dicts)
    agent_logger.info(
        "ROWS_VALIDATED run_id=%s table=%s input=%s valid=%s invalid=%s repaired=%s",
        _SESSION.get("run_id"), table_name, len(rows or []), len(result.valid_rows), len(result.invalid_rows), result.repaired_count,
    )
    if result.invalid_rows and _cfg_value("invalid_row_policy", "quarantine") == "reject":
        raise ValueError(f"Invalid rows for {table_name}: {len(result.invalid_rows)}")
    return result.valid_rows


def _context_summary(prompt_payload: Dict[str, Any]) -> Dict[str, Any]:
    public_summary = prompt_payload.get("public_information_summary") or ""
    marketplace_dashboard = prompt_payload.get("marketplace_dashboard") or {}
    customer_contexts = prompt_payload.get("customer_contexts") or []
    candidate_offers = prompt_payload.get("eligible_public_offers") or prompt_payload.get("public_bank_offers") or prompt_payload.get("candidate_offers") or []
    return {
        "timestep": prompt_payload.get("timestep"),
        "agent_name": prompt_payload.get("agent_name"),
        "actor_type": prompt_payload.get("actor_type"),
        "actor_id": prompt_payload.get("actor_id"),
        "public_rows": len(prompt_payload.get("public_information") or []),
        "has_public_summary": bool(public_summary),
        "public_summary_chars": len(str(public_summary)),
        "has_marketplace_dashboard": bool(marketplace_dashboard),
        "marketplace_dashboard_timestep": marketplace_dashboard.get("dashboard_timestep") if isinstance(marketplace_dashboard, dict) else None,
        "candidate_offer_count": len(candidate_offers) if isinstance(candidate_offers, list) else 0,
        "customer_count": len(customer_contexts) if isinstance(customer_contexts, list) else 0,
        "has_private_summary": bool(prompt_payload.get("own_private_summary") or prompt_payload.get("bank_private_summary")),
    }


