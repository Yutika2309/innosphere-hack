async def _run_remaining_timesteps_via_subagent() -> Dict[str, Any]:
    sim = _require_sim()
    if sim is None:
        return {"status": "error", "message": "Initialize simulation first."}
    remaining = max(sim.cfg.timesteps - sim.current_timestep, 0)
    if remaining == 0:
        return {"status": "done", "message": "Simulation already complete.", "final_status": get_status()}

    app_name = "lending_world_sub_agent_app"
    user_id = "lending_world_sub_user"
    session_service = InMemorySessionService()
    runner = Runner(agent=orchestration_sub_agent, app_name=app_name, session_service=session_service)
    results = []
    agent_logger.info("ORCHESTRATION_RUN_START run_id=%s remaining=%s", _SESSION.get("run_id"), remaining)

    for i in range(remaining):
        sim = _require_sim()
        if sim is None or sim.completed:
            break
        session_id = f"orchestration_step_session_{_SESSION['run_id']}_{i + 1}_{uuid.uuid4().hex[:6]}"
        agent_logger.info("ORCHESTRATION_SUB_AGENT_CALL_START run_id=%s iteration=%s session_id=%s next_timestep=%s", _SESSION.get("run_id"), i + 1, session_id, sim.current_timestep + 1)
        started = time.time()
        await session_service.create_session(app_name=app_name, user_id=user_id, session_id=session_id)
        events_stream = runner.run_async(user_id=user_id, session_id=session_id, new_message=Content(role="user", parts=[Part(text="run exactly one timestep")]))
        final_text = ""
        async for event in events_stream:
            if event.is_final_response():
                if event.content and event.content.parts:
                    final_text = event.content.parts[0].text or ""
                break
        elapsed = round(time.time() - started, 3)
        agent_logger.info("ORCHESTRATION_SUB_AGENT_CALL_DONE run_id=%s iteration=%s session_id=%s elapsed_sec=%s final_text_chars=%s", _SESSION.get("run_id"), i + 1, session_id, elapsed, len(final_text or ""))
        results.append({"iteration": i + 1, "session_id": session_id, "agent_reply": final_text, "status_snapshot": get_status()})

    agent_logger.info("ORCHESTRATION_RUN_DONE run_id=%s executed_iterations=%s", _SESSION.get("run_id"), len(results))
    return {"status": "ok", "requested_iterations": remaining, "executed_iterations": len(results), "results": results, "final_status": get_status(), "funnel_metrics": get_funnel_metrics(), "db_loss_analysis": get_db_loss_analysis(), "db_recommendations": get_db_recommendations()}


async def run_simulation() -> Dict[str, Any]:
    if _require_sim() is None:
        initialize_simulation()
    return await _run_remaining_timesteps_via_subagent()


async def run_baseline_scenario() -> Dict[str, Any]:
    set_config_overrides({"scenario_name": "baseline_current_db", "scenario_mode": "baseline", "enable_db_improvements": False})
    init = initialize_simulation()
    result = await _run_remaining_timesteps_via_subagent()
    sim = _require_sim()
    if sim is not None and hasattr(sim, "build_scenario_summary_row"):
        sim.build_scenario_summary_row("baseline_current_db")
    return {"status": "ok", "initialization": init, "result": result, "scenario_comparison": get_scenario_comparison(), "active_overrides": dict(_SESSION["config_overrides"])}


async def run_improved_scenario(improvement_type: str = "combined_strategy") -> Dict[str, Any]:
    set_config_overrides({"scenario_name": f"improved_{improvement_type}", "scenario_mode": "improved", "enable_db_improvements": True})
    init = initialize_simulation()
    result = await _run_remaining_timesteps_via_subagent()
    sim = _require_sim()
    if sim is not None and hasattr(sim, "build_scenario_summary_row"):
        sim.build_scenario_summary_row(f"improved_{improvement_type}")
    return {"status": "ok", "initialization": init, "result": result, "scenario_comparison": get_scenario_comparison(), "active_overrides": dict(_SESSION["config_overrides"])}


async def run_scenario_comparison() -> Dict[str, Any]:
    baseline = await run_baseline_scenario()
    improved = await run_improved_scenario("combined_strategy")
    return {"status": "ok", "baseline": baseline, "improved": improved, "note": "Each timestep was executed through a separate sub-agent run_async invocation."}


