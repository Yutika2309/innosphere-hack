def _parallel_agent_semaphore_limit() -> int:
    try:
        return max(1, int(_cfg_value("parallel_agent_semaphore_limit", 8)))
    except Exception:
        return 8


def _get_parallel_agent_semaphore() -> asyncio.Semaphore:
    limit = _parallel_agent_semaphore_limit()
    existing = _SESSION.get("parallel_agent_semaphore")
    existing_limit = _SESSION.get("parallel_agent_semaphore_limit")
    if existing is None or existing_limit != limit:
        _SESSION["parallel_agent_semaphore"] = asyncio.Semaphore(limit)
        _SESSION["parallel_agent_semaphore_limit"] = limit
        agent_logger.info("PARALLEL_LIMIT run_id=%s max_active_agent_calls=%s", _SESSION.get("run_id"), limit)
    return _SESSION["parallel_agent_semaphore"]


