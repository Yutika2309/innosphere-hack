def record_world_news_rows(payload: Dict[str, Any]) -> Dict[str, Any]:
    raw_rows = _rows_from_payload(payload)
    rows = _validate_rows_for_table("world_news", raw_rows, context={"actor_id": "world_news"})
    min_rows = int(_cfg_value("world_news_min_rows_per_timestep", 1) or 0)
    if len(rows) < min_rows:
        agent_logger.warning("WORLD_NEWS_TOO_FEW_ROWS run_id=%s expected_min=%s actual=%s", _SESSION.get("run_id"), min_rows, len(rows))
    agent_logger.info("TOOL world_news_agent run_id=%s rows=%s", _SESSION.get("run_id"), len(rows))
    return _append_pending("world_news", rows)


def record_customer_rows(payload: Dict[str, Any]) -> Dict[str, Any]:
    consumer_actions_raw = _rows_from_payload(payload, "consumer_actions")
    funnel_events_raw = _rows_from_payload(payload, "funnel_events")
    customer_feedback_raw = _rows_from_payload(payload, "customer_feedback")
    consumer_actions = _validate_rows_for_table("consumer_actions", consumer_actions_raw)
    funnel_events = _validate_rows_for_table("funnel_events", funnel_events_raw)
    customer_feedback = _validate_rows_for_table("customer_feedback", customer_feedback_raw)
    if not _cfg_value("customer_allow_empty_batch_output", False) and not consumer_actions:
        agent_logger.warning("CUSTOMER_BATCH_EMPTY_OUTPUT run_id=%s raw_actions=%s raw_funnel=%s raw_feedback=%s", _SESSION.get("run_id"), len(consumer_actions_raw), len(funnel_events_raw), len(customer_feedback_raw))
    agent_logger.info("TOOL customer_agent run_id=%s consumer_actions=%s funnel_events=%s customer_feedback=%s", _SESSION.get("run_id"), len(consumer_actions), len(funnel_events), len(customer_feedback))
    return {"status": "ok", "consumer_actions": _append_pending("consumer_actions", consumer_actions), "funnel_events": _append_pending("funnel_events", funnel_events), "customer_feedback": _append_pending("customer_feedback", customer_feedback), "message": "Customer rows recorded and schema-validated. Do not call this tool again. Return final response now."}


def record_bank_rows(payload: Dict[str, Any]) -> Dict[str, Any]:
    context_bank_id = payload.get("bank_id") or payload.get("actor_id")
    context = {"bank_id": context_bank_id, "actor_id": context_bank_id}
    bank_actions_raw = _rows_from_payload(payload, "bank_actions")
    bank_offers_raw = _rows_from_payload(payload, "bank_offers")
    marketing_actions_raw = _rows_from_payload(payload, "marketing_actions")
    bank_actions = _validate_rows_for_table("bank_actions", bank_actions_raw, context=context)
    bank_offers = _validate_rows_for_table("bank_offers", bank_offers_raw, context=context)
    marketing_actions = _validate_rows_for_table("marketing_actions", marketing_actions_raw, context=context)
    agent_logger.info("TOOL bank_agent run_id=%s bank_id=%s bank_actions=%s bank_offers=%s marketing_actions=%s", _SESSION.get("run_id"), context_bank_id, len(bank_actions), len(bank_offers), len(marketing_actions))
    return {"status": "ok", "bank_actions": _append_pending("bank_actions", bank_actions), "bank_offers": _append_pending("bank_offers", bank_offers), "marketing_actions": _append_pending("marketing_actions", marketing_actions), "message": "Bank rows recorded and schema-validated. Do not call this tool again. Return final response now."}


def record_marketplace_rows(payload: Dict[str, Any]) -> Dict[str, Any]:
    rankings_raw = _rows_from_payload(payload, "marketplace_rankings")
    recommendations_raw = _rows_from_payload(payload, "marketplace_recommendations")
    visibility_events_raw = _rows_from_payload(payload, "marketplace_visibility_events")
    rankings = _validate_rows_for_table("marketplace_rankings", rankings_raw)
    recommendations = _validate_rows_for_table("marketplace_recommendations", recommendations_raw)
    visibility_events = _validate_rows_for_table("marketplace_visibility_events", visibility_events_raw)
    if _cfg_value("marketplace_require_output_if_public_offers_exist", True) and not (rankings or recommendations or visibility_events):
        agent_logger.warning("MARKETPLACE_EMPTY_OUTPUT run_id=%s reason=%s", _SESSION.get("run_id"), payload.get("no_output_reason") or payload.get("reason"))
    agent_logger.info("TOOL marketplace_agent run_id=%s rankings=%s recommendations=%s visibility_events=%s", _SESSION.get("run_id"), len(rankings), len(recommendations), len(visibility_events))
    return {"status": "ok", "marketplace_rankings": _append_pending("marketplace_rankings", rankings), "marketplace_recommendations": _append_pending("marketplace_recommendations", recommendations), "marketplace_visibility_events": _append_pending("marketplace_visibility_events", visibility_events), "message": "Marketplace rows recorded and schema-validated. Do not call this tool again. Return final response now."}


def acknowledge_post_processing(payload: Dict[str, Any]) -> Dict[str, Any]:
    note = dict(payload or {})
    _SESSION.setdefault("post_processing_notes", []).append(note)
    sim = _require_sim()
    timestep = sim.current_timestep if sim is not None else None
    public_summary = note.get("public_information_summary") or note.get("public_summary") or note.get("summary")
    summary_result = None
    if public_summary and timestep is not None:
        summary_result = _record_public_information_summary(str(public_summary), int(timestep))
    agent_logger.info("TOOL post_processing run_id=%s notes=%s public_summary_chars=%s", _SESSION.get("run_id"), len(_SESSION["post_processing_notes"]), len(str(public_summary or "")))
    return {"status": "ok", "notes_recorded": len(_SESSION["post_processing_notes"]), "public_summary_recorded": bool(summary_result and summary_result.get("status") == "ok"), "message": "Post-processing acknowledged. Do not call this tool again. Return final response now."}


