def _load_defaults() -> Dict[str, Any]:
    return load_default_config("default_configs.json")


def _agent_model(agent_key: str, fallback: str) -> str:
    defaults = _load_defaults()
    return str((defaults.get("agent_models") or {}).get(agent_key, fallback))


def _build_sim(config_overrides: Optional[Dict[str, Any]] = None) -> LendingWorldSimulation:
    class _Args:
        pass

    merged = dict(_SESSION.get("config_overrides", {}))
    if config_overrides:
        merged.update(config_overrides)
    cfg = resolve_config(_load_defaults(), _Args(), chat_overrides=merged)
    return LendingWorldSimulation(cfg)


def _require_sim() -> Optional[LendingWorldSimulation]:
    return _SESSION.get("sim")


def _cfg_value(name: str, default: Any) -> Any:
    sim = _require_sim()
    if sim is not None:
        return getattr(sim.cfg, name, default)
    return default


def _pending_timestep() -> int:
    sim = _require_sim()
    if sim is None:
        return 1
    return int(getattr(sim, "current_timestep", 0) or 0) + 1


def _safe_engine_call(sim: LendingWorldSimulation, method_name: str, row_attr: str) -> Dict[str, Any]:
    if hasattr(sim, method_name):
        return getattr(sim, method_name)()
    return {"status": "ok", "rows": getattr(sim, row_attr, [])}


