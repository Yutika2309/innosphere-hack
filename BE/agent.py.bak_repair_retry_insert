def _chunks(items: List[Any], size: int) -> List[List[Any]]:
    size = max(1, int(size or 1))
    return [items[i : i + size] for i in range(0, len(items), size)]


def _latest_public_summary() -> Dict[str, Any]:
    sim = _require_sim()
    default = {"public_information_summary": "No public summary available.", "summary_from_timestep": None, "summary_to_timestep": None, "window_size": _public_summary_window()}
    if sim is None:
        return default
    rows = getattr(sim, "public_information_summary_rows", []) or []
    if not rows:
        return default
    latest = dict(rows[-1])
    return {
        "public_information_summary": latest.get("public_information_summary", default["public_information_summary"]),
        "summary_from_timestep": latest.get("summary_from_timestep"),
        "summary_to_timestep": latest.get("summary_to_timestep"),
        "window_size": latest.get("window_size", default["window_size"]),
    }


def _replace_public_rows_with_summary(ctx: Dict[str, Any]) -> Dict[str, Any]:
    ctx = dict(ctx or {})
    summary = _latest_public_summary()
    ctx.pop("public_information", None)
    ctx.pop("recent_public_events", None)
    ctx["public_information_summary"] = summary["public_information_summary"]
    ctx["public_summary_from_timestep"] = summary["summary_from_timestep"]
    ctx["public_summary_to_timestep"] = summary["summary_to_timestep"]
    ctx["public_summary_window_size"] = summary["window_size"]
    return ctx


def _latest_committed_marketplace_dashboard() -> Dict[str, Any]:
    sim = _require_sim()
    if sim is None:
        return {"dashboard_timestep": None, "dashboard_summary": "No marketplace dashboard available yet."}
    if hasattr(sim, "get_latest_marketplace_dashboard"):
        try:
            return sim.get_latest_marketplace_dashboard()
        except Exception:
            pass
    rows = getattr(sim, "marketplace_dashboard_rows", []) or []
    if rows:
        return dict(rows[-1])
    return {"dashboard_timestep": getattr(sim, "current_timestep", None), "dashboard_summary": "No marketplace dashboard available yet."}


def _build_customer_batch_payload(contexts: List[Dict[str, Any]], timestep: int, batch_index: int) -> Dict[str, Any]:
    compact_contexts: List[Dict[str, Any]] = []
    public_summary = _latest_public_summary()
    marketplace_dashboard = _latest_committed_marketplace_dashboard()
    for ctx in contexts:
        clean = dict(ctx or {})
        clean.pop("public_information", None)
        clean.pop("recent_public_events", None)
        clean.pop("current_marketplace_public_signals", None)
        clean.setdefault("source_preferences", {
            "marketplace_reliance": _cfg_value("default_marketplace_reliance", 0.5),
            "public_news_reliance": _cfg_value("default_public_news_reliance", 0.3),
            "relationship_bank_reliance": _cfg_value("default_relationship_bank_reliance", 0.4),
            "branch_advice_preference": _cfg_value("default_branch_advice_preference", 0.2),
            "digital_comparison_preference": _cfg_value("default_digital_comparison_preference", 0.5),
        })
        compact_contexts.append(clean)
    actor_ids = [str(ctx.get("actor_id") or ctx.get("consumer_id")) for ctx in compact_contexts if ctx.get("actor_id") or ctx.get("consumer_id")]
    return {
        "timestep": timestep,
        "agent_name": "customer_agent",
        "actor_type": "customer_batch",
        "actor_id": ",".join(actor_ids),
        "batch_index": batch_index,
        "batch_size": len(compact_contexts),
        "customer_contexts": compact_contexts,
        "public_information_summary": public_summary.get("public_information_summary"),
        "public_summary_from_timestep": public_summary.get("summary_from_timestep"),
        "public_summary_to_timestep": public_summary.get("summary_to_timestep"),
        "marketplace_dashboard": marketplace_dashboard,
        "marketplace_dashboard_source": "committed_previous_timestep",
        "batch_instruction": "Process each customer independently. Do not mix private state. Emit at least one valid consumer_action per active customer with consumer_id and actor_id. Emit funnel_event when stage changes.",
    }


def _record_public_information_summary(summary_text: str, timestep: int) -> Dict[str, Any]:
    sim = _require_sim()
    if sim is None:
        return {"status": "error", "message": "Initialize simulation first."}
    window = _public_summary_window()
    from_ts = max(1, timestep - window + 1)
    row = {"run_id": _SESSION.get("run_id"), "timestep": timestep, "summary_from_timestep": from_ts, "summary_to_timestep": timestep, "window_size": window, "public_information_summary": summary_text, "created_by": "post_processing_agent"}
    if not hasattr(sim, "public_information_summary_rows"):
        sim.public_information_summary_rows = []
    sim.public_information_summary_rows.append(row)
    path = Path(getattr(sim.cfg, "output_dir", "output")) / "public_information_summary.csv"
    path.parent.mkdir(parents=True, exist_ok=True)
    import csv
    write_header = not path.exists()
    with path.open("a", encoding="utf-8", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=list(row.keys()))
        if write_header:
            writer.writeheader()
        writer.writerow(row)
    agent_logger.info("PUBLIC_SUMMARY_RECORDED run_id=%s timestep=%s window=%s-%s chars=%s", _SESSION.get("run_id"), timestep, from_ts, timestep, len(summary_text or ""))
    return {"status": "ok", "summary_row": row}


def _log_stage(stage: str, timestep: int, message: str = "", **details: Any) -> None:
    detail_text = " ".join(f"{k}={v}" for k, v in details.items() if v is not None)
    suffix = f" | {message}" if message else ""
    agent_logger.info("STEP %s | T%s | %s%s", stage, timestep, detail_text, suffix)


